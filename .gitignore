local/

# 本地工作树（git worktree 挂载点）
/.worktrees/

# 构建产物
# /build-*/ 通配所有 build-* 目录：此前逐个列名，2026-10 新建 build-reltest/ 时漏掉，
# 误把 36 MB 构建产物提交进 dev（已 amend 掉）。新增构建目录不必再改本文件。
/build-*/
/build/
/cmake-build-*/
/out/
/out-linux/
*.user

# vcpkg
/vcpkg_installed/

# CMake 生成
CMakeUserPresets.json
compile_commands.json
.cache/

# IDE
.vs/
.vscode/
.idea/

# 编辑器运行时缓存（波形金字塔等，见 doc/core-model.md §8）
**/.beatbench-cache/

# QML 运行期错误日志（调试钩子，main.cpp 写）
beatbench-qml-errors.log

# 视觉工具运行时缓存
.dsh-vision-toolkit/

# 测试目录只跟踪明确的基准输入；编辑备份、导出分片、渲染等产物不入库。
# 新增测试项目/基准文件时显式补白名单，避免把手测产物当作 fixture 提交。
/testdata/*
!/testdata/m7-mini-project/
/testdata/m7-mini-project/*
!/testdata/m7-mini-project/README.md
!/testdata/m7-mini-project/01-easy.bms
!/testdata/m7-mini-project/02-hard.bms
!/testdata/m7-mini-project/03-base62.bms
!/testdata/m7-mini-project/m7-mini-tone-low.wav
!/testdata/m7-mini-project/m7-mini-tone-mid.wav
!/testdata/m7-mini-project/m7-mini-tone-high.wav
!/testdata/m7-mini-project/slice-onsets.wav
!/testdata/m7-mini-project/slice-onsets.json
