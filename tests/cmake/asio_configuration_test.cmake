# Configuration contract checks require neither a compiler nor SDK download.
if(DEFINED BB_ASIO_PROBE)
  include(FetchContent)
  if(BB_ASIO_PROBE STREQUAL "off")
    set(WIN32 FALSE)
    set(BEATBENCH_ENABLE_ASIO OFF CACHE BOOL "" FORCE)
    set(PA_USE_ASIO ON CACHE BOOL "" FORCE)
  elseif(BB_ASIO_PROBE STREQUAL "nonwindows")
    set(WIN32 FALSE)
    set(BEATBENCH_ENABLE_ASIO ON CACHE BOOL "" FORCE)
  elseif(BB_ASIO_PROBE STREQUAL "missing")
    set(WIN32 TRUE)
    set(BEATBENCH_ENABLE_ASIO ON CACHE BOOL "" FORCE)
    set(BEATBENCH_ASIO_SDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/__nonexistent_asiosdk__" CACHE PATH "" FORCE)
  endif()
  include("${CMAKE_CURRENT_LIST_DIR}/../../audio/cmake/AsioSdk.cmake")
  if(PA_USE_ASIO)
    message(FATAL_ERROR "OFF failed to override stale PA_USE_ASIO=ON")
  endif()
  return()
endif()

foreach(_mode IN ITEMS off nonwindows missing)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DBB_ASIO_PROBE=${_mode}"
      -P "${CMAKE_CURRENT_LIST_FILE}"
      RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(_mode STREQUAL "off")
    if(NOT _result EQUAL 0)
      message(FATAL_ERROR "OFF contract failed: ${_out}${_err}")
    endif()
  else()
    if(_result EQUAL 0)
      message(FATAL_ERROR "Explicit ON unexpectedly succeeded for ${_mode}")
    endif()
    if(_mode STREQUAL "nonwindows" AND NOT "${_out}${_err}" MATCHES "supported only on Windows")
      message(FATAL_ERROR "Wrong non-Windows failure: ${_out}${_err}")
    endif()
    if(_mode STREQUAL "missing" AND NOT "${_out}${_err}" MATCHES "Incomplete ASIO SDK")
      message(FATAL_ERROR "Wrong incomplete SDK failure: ${_out}${_err}")
    endif()
  endif()
endforeach()
message(STATUS "ASIO opt-in configuration contracts passed")
